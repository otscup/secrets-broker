# Copy to .env and fill in. Never commit the filled .env.
#
# Bitwarden-compatible vault (NodeWarden / Vaultwarden / Bitwarden).
BW_SERVER=https://vault.example.com

# NodeWarden / Bitwarden personal API key (used by `bw login --apikey`).
BW_CLIENTID=user.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for remote admin access (login page). Pick a strong password.
SECRETS_BROKER_ADMIN_PASSWORD=change-me

# Public URL used in approval links and OAuth metadata.
BROKER_PUBLIC_URL=https://broker.example.com

# Bind address inside the container. Restrict exposure with Docker port
# binding, Tailscale/WireGuard, or a Cloudflare Tunnel instead of exposing it
# directly to the internet.
SECRETS_BROKER_BIND=0.0.0.0

# Optional OIDC login for the admin page (any standard provider).
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://broker.example.com/oidc/callback

# Optional notification providers (all are optional).
# NTFY_URL=https://ntfy.example.com/secrets-topic
# GOTIFY_URL=http://gotify:80
# GOTIFY_TOKEN=your-gotify-app-token
# WXPUSH_URL=https://wxpush.example.com
# WXPUSH_TOKEN=your-wxpush-api-token
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# Expose get_secret over MCP (returns plaintext to the calling model).
# MCP_ALLOW_READ=1
